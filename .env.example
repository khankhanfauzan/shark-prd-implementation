# ============================================================
# DATABASE CONFIGURATION
# ============================================================
#
# Sesuaikan dengan kredensial PostgreSQL lokal Anda.
# Jalankan perintah berikut untuk melihat username Postgres Anda:
#   Mac/Linux: whoami
#   Windows:   echo %USERNAME%
#
# FORMAT:
#   Tanpa password : DATABASE_URL="postgresql://USERNAME@HOST:PORT/DB_NAME?schema=public"
#   Dengan password: DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:PORT/DB_NAME?schema=public"
#
# ⚠️  PERHATIAN: Jika akun PostgreSQL Anda TIDAK memiliki password,
#     JANGAN tambahkan tanda titik dua (:) setelah username.
#
#   ✅ BENAR : DATABASE_URL="postgresql://username@127.0.0.1:5432/shark_db?schema=public"
#   ❌ SALAH  : DATABASE_URL="postgresql://username:@127.0.0.1:5432/shark_db?schema=public"
#
# 💡 CATATAN: 127.0.0.1 vs localhost
#   Gunakan 127.0.0.1 (bukan localhost) untuk memaksa koneksi via TCP/IP.
#   Di Mac/Linux, 'localhost' bisa menggunakan Unix Socket yang perilakunya
#   berbeda tergantung konfigurasi pg_hba.conf di sistem Anda.
#
#   127.0.0.1  → selalu TCP/IP  → konsisten di semua OS ✅ (direkomendasikan)
#   localhost   → Unix Socket*  → bisa berbeda di Mac/Linux ⚠️
#
DATABASE_URL="postgresql://YOUR_PG_USERNAME@127.0.0.1:5432/shark_db?schema=public"

# ============================================================
# FRONTEND CONFIGURATION
# ============================================================
NEXT_PUBLIC_API_URL="http://localhost:3001"
